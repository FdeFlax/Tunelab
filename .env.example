# Fuente de datos del tunel.
# Valores validos:
# - simulado: modo seguro para desarrollo y defensa.
# - real: usa src/servicios/tunel/tunelReal.js cuando exista conexion fisica.
VITE_FUENTE_TUNEL=simulado

# API local preparada para MySQL. Si no esta arrancada, la app puede seguir en modo demo.
VITE_API_URL=http://127.0.0.1:8010/api
