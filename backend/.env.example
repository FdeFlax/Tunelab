# Si no existe .env, el backend usa una base local de pruebas: sqlite:///./tunelab_local.db
# Copia este archivo como .env cuando quieras probar MySQL en local.
# Los tecnicos de la UA cambiaran esta cadena para apuntar al servidor real.
DATABASE_URL=mysql+pymysql://usuario:contrasena@localhost:3306/tunel_viento
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
APP_NOMBRE=Tunelab API
LIMITE_ENSAYOS_POR_USUARIO=20
LIMITE_MEDICIONES_POR_ENSAYO=20
