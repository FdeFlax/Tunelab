# Copia este archivo como .env para configurar la base de datos local.
# En desarrollo debe apuntar a tu MySQL local.
# En eServices los tecnicos cambiaran esta cadena para apuntar al servidor real.
DATABASE_URL=mysql+pymysql://usuario:contrasena@localhost:3306/tunel_viento
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
APP_NOMBRE=Tunelab API
# Por defecto se bloquea el acceso hasta integrar UACloud.
ENTORNO=produccion
AUTENTICACION_MODO=bloqueada
# Solo para desarrollo DIRECTO en este equipo, sin proxy:
# ENTORNO=desarrollo
# AUTENTICACION_MODO=demo
LIMITE_ENSAYOS_POR_USUARIO=20
LIMITE_MEDICIONES_POR_ENSAYO=20

# Flujo 3D docente opcional, calculado en el servidor (XLB/Warp y GPU CUDA).
FLUJO3D_HABILITADO=false
# Ruta al Python del entorno de cálculo; vacía usa tmp/evaluacion-xlb/.venv.
FLUJO3D_PYTHON=
