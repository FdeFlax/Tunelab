# Configuracion publica incluida en el bundle del navegador.
# No pongas contrasenas, tokens ni claves privadas en variables VITE_.

# En un despliegue real solo debe usarse "real" cuando tunelReal.js este conectado
# a una capa segura de laboratorio. Hasta entonces, mantener "simulado".
VITE_FUENTE_TUNEL=simulado

# URL publica de la API que configuraran los tecnicos en servidor.
VITE_API_URL=https://eservices.ua.es/tunelab/api
